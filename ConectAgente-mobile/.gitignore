# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# expo-env.d.ts é commitado para evitar erros de TypeScript no VS Code
# (o Expo gera este arquivo automaticamente, mas ele é necessário para tipagem)

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# APK gerado para instalar no aparelho.
#
# Fica fora do repositorio por tamanho: o pacote com todas as ABIs passa de
# 90 MB, o GitHub avisa acima de 50 MB e recusa acima de 100 MB. Quem precisa
# do arquivo gera com as instrucoes de docs/apk.md.
release/
*.apk
*.aab
