{
  "name": "conectagente",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "./jest.fuso.js",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|date-fns|xlsx|@supabase)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/app/**",
      "!src/lib/**",
      "!src/contexts/**",
      "!src/components/forms/**",
      "!src/components/input/**",
      "!src/components/ui/LoadingSpinner.tsx",
      "!src/components/ui/PageHeader.tsx",
      "!src/components/ui/SyncIndicator.tsx",
      "!src/database/database.ts",
      "!src/database/schema.ts",
      "!src/database/repositories/prontuarioRepository.ts",
      "!src/database/repositories/syncQueueRepository.ts",
      "!src/hooks/useMoradores.ts",
      "!src/services/api.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.2",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~54.0.0",
    "expo-background-task": "~1.0.10",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-navigation-bar": "~5.0.10",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1309.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.17",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "private": true,
  "overrides": {
    "shell-quote": "^1.12.0",
    "follow-redirects": "^1.16.1",
    "nanoid@3": "3.3.20",
    "source-map-js": "^1.2.2",
    "undici@6": "6.29.1",
    "tar": "^7.5.22",
    "compression": "^1.8.2",
    "moment": "^2.31.0",
    "postcss": "^8.5.29",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.28",
    "@xmldom/xmldom": "^0.8.15",
    "@expo/code-signing-certificates": "^0.0.7",
    "decode-uri-component": "^0.5.1",
    "@react-navigation/core": "^7.23.0",
    "node-forge": "1.4.3"
  }
}
