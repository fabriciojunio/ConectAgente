{
  "expo": {
    "name": "ConectAgente",
    "slug": "ConectAgente",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/images/LOGO-remove.png",
    "scheme": "conectagente",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/LOGO-remove.png",
      "resizeMode": "contain",
      "backgroundColor": "#a9c7c3"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LOGO-remove.png",
        "backgroundColor": "#a9c7c3"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    }
  }
}
